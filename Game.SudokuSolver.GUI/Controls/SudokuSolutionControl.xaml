<UserControl
    x:Class="Game.SudokuSolver.GUI.Controls.SudokuSolutionControl"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Game.SudokuSolver.GUI.Controls"
    xmlns:models="clr-namespace:Game.SudokuSolver.GUI.Models"
    d:DataContext="{d:DesignInstance Type=models:SudokuBoardSolutionModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ControlTemplate x:Key="LeftArrowButtonTemplate" TargetType="Button">
            <Grid>
                <Polygon
                    x:Name="poly"
                    Points="0,25 50,0 50,10 100,10 100,40 50,40 50,50"
                    Fill="{TemplateBinding Background}"
                    Stroke="{TemplateBinding BorderBrush}"
                    StrokeThickness="2"
                    Stretch="Fill"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="poly" Property="Fill" Value="DarkGray"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="poly" Property="Fill" Value="Gray"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="RightArrowButtonTemplate" TargetType="Button">
            <Grid>
                <Polygon
                    x:Name="poly"
                    Points="0,10 50,10 50,0 100,25 50,50 50,40 0,40"
                    Fill="{TemplateBinding Background}"
                    Stroke="{TemplateBinding BorderBrush}"
                    StrokeThickness="2"
                    Stretch="Fill"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="poly" Property="Fill" Value="DarkGray"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="poly" Property="Fill" Value="Gray"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="LeftArrowStyle" TargetType="Button">
            <EventSetter Event="Click" Handler="PreviousButtonEventHandler"/>
            <Setter Property="Visibility" Value="{Binding PreviousStepButtonVisibility}"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Template" Value="{StaticResource LeftArrowButtonTemplate}"/>
        </Style>
        <Style x:Key="RightArrowStyle" TargetType="Button">
            <EventSetter Event="Click" Handler="NextButtonClickedEventHandler"/>
            <Setter Property="Visibility" Value="{Binding NextStepButtonVisibility}"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Template" Value="{StaticResource RightArrowButtonTemplate}"/>
        </Style>
    </UserControl.Resources>
    <StackPanel
        Orientation="Vertical"
        Keyboard.KeyDown="KeyDownEventHandler">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" Margin="2" FontSize="20" FontWeight="Bold" Text="解答結果:"/>
            <TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" Margin="2" FontSize="20">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccess}" Value="true">
                                <Setter Property="Text" Value="成功"/>
                                <Setter Property="Foreground" Value="Blue"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSuccess}" Value="false">
                                <Setter Property="Text" Value="失敗"/>
                                <Setter Property="Foreground" Value="Red"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" Margin="2" FontSize="20" FontWeight="Bold" Text="解法の難易度:"/>
            <TextBlock Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" Margin="2" FontSize="20" Text="{Binding SolutionDifficulty}"/>
        </Grid>
        <StackPanel Orientation="Horizontal" x:Name="BoardListPanel" x:FieldModifier="private"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="100" Height="50" Margin="10,5,5,5"
                Content="前のステップへ"
                Style="{StaticResource LeftArrowStyle}">
            </Button>
            <TextBlock VerticalAlignment="Center" MinWidth="200" Margin="10,5,10,5" FontSize="20" TextAlignment="Center" Text="{Binding CurrentStepTitle}"/>
            <Button
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="100" Height="50" Margin="5,5,10,5"
                Content="次のステップへ"
                Style="{StaticResource RightArrowStyle}">
            </Button>
        </StackPanel>
            
    </StackPanel>
</UserControl>
