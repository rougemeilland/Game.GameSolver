<UserControl
    x:Class="Game.SudokuSolver.GUI.Controls.SudokuBoardCellControl"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Game.SudokuSolver.GUI.Controls" xmlns:models="clr-namespace:Game.SudokuSolver.GUI.Models" d:DataContext="{d:DesignInstance Type=models:SudokuBoardCellModel}"
    mc:Ignorable="d">
    <Grid x:Name="CellContainer" x:FieldModifier="private">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Canvas Panel.ZIndex="2" Width="45" Height="45" x:Name="CellDeterminedDigitContainer" x:FieldModifier="private">
            <Rectangle Canvas.Left="1" Canvas.Top="1" Panel.ZIndex="1" Width="43" RadiusX="10" RadiusY="10" Height="43" StrokeThickness="0" x:Name="CellDeterminedDigitBackgroundRectangle" x:FieldModifier="private"/>
            <TextBlock Canvas.Left="-10" Canvas.Top="-14" Width="65" Height="65" Panel.ZIndex="2" TextAlignment="Center" FontSize="50" Text="{Binding DeterminedDigit}" x:Name="CellDeterminedDigitTextBlock" x:FieldModifier="private"/>
        </Canvas>
        <Grid Panel.ZIndex="1" x:Name="CellNotesContainer" x:FieldModifier="private">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <local:SudokuBoardCellNoteControl Grid.Column="0" Grid.Row="0" Panel.ZIndex="1" DataContext="{Binding Notes[0]}"/>
            <local:SudokuBoardCellNoteControl Grid.Column="1" Grid.Row="0" Panel.ZIndex="1" DataContext="{Binding Notes[1]}"/>
            <local:SudokuBoardCellNoteControl Grid.Column="2" Grid.Row="0" Panel.ZIndex="1" DataContext="{Binding Notes[2]}"/>
            <local:SudokuBoardCellNoteControl Grid.Column="0" Grid.Row="1" Panel.ZIndex="1" DataContext="{Binding Notes[3]}"/>
            <local:SudokuBoardCellNoteControl Grid.Column="1" Grid.Row="1" Panel.ZIndex="1" DataContext="{Binding Notes[4]}"/>
            <local:SudokuBoardCellNoteControl Grid.Column="2" Grid.Row="1" Panel.ZIndex="1" DataContext="{Binding Notes[5]}"/>
            <local:SudokuBoardCellNoteControl Grid.Column="0" Grid.Row="2" Panel.ZIndex="1" DataContext="{Binding Notes[6]}"/>
            <local:SudokuBoardCellNoteControl Grid.Column="1" Grid.Row="2" Panel.ZIndex="1" DataContext="{Binding Notes[7]}"/>
            <local:SudokuBoardCellNoteControl Grid.Column="2" Grid.Row="2" Panel.ZIndex="1" DataContext="{Binding Notes[8]}"/>
        </Grid>
    </Grid>
</UserControl>
